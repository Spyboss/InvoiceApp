package views

import (
	"strings"
	"time"
)

type AlertRow struct {
	KindLabel string
	Message   string
	Severity  string
	Status    string
	Attempts  int
	LastError string
	At        time.Time
	Sent      string
}

type AlertsData struct {
	TenantName string
	UserName   string
	Nav        []NavLink
	CSRFToken  string
	Rows       []AlertRow
	// Email and Telegram are the channels set in settings, so the page can say
	// where an alert went as well as whether it went.
	Email    string
	Telegram string
}

templ Alerts(d AlertsData) {
	@Layout("Alerts", d.TenantName, d.UserName, d.CSRFToken, d.Nav, alertsBody(d))
}

templ alertsBody(d AlertsData) {
	<article class="wide">
		<h1>Alerts</h1>

		<dl class="facts">
			<dt>Delivery</dt>
			<dd>{ deliveryLine(d.Email, d.Telegram) }</dd>
		</dl>

		if len(d.Rows) == 0 {
			<p class="muted">Nothing has fired.</p>
		} else {
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th scope="col">When (UTC)</th>
							<th scope="col">What</th>
							<th scope="col">Detail</th>
							<th scope="col">Severity</th>
							<th scope="col">Delivery</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range d.Rows {
							<tr>
								<td>{ row.At.UTC().Format("2006-01-02 15:04:05") }</td>
								<td><strong>{ row.KindLabel }</strong></td>
								<td>{ row.Message }</td>
								<td><span class="status">{ row.Severity }</span></td>
								<td>
									<span class="status">{ row.Status }</span>
									if row.Sent != "" {
										<small>{ row.Sent }</small>
									}
									if row.Attempts > 1 {
										<small>{ row.Attempts } tries</small>
									}
									if row.LastError != "" {
										<small>{ row.LastError }</small>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</article>
}

// deliveryLine says where alerts are sent besides this page, named by channel
// so an empty setting reads as a fact rather than a warning.
func deliveryLine(email, telegram string) string {
	channels := make([]string, 0, 2)
	if email != "" {
		channels = append(channels, email)
	}
	if telegram != "" {
		channels = append(channels, "Telegram "+telegram)
	}
	if len(channels) == 0 {
		return "this page only"
	}
	return strings.Join(channels, ", ")
}
