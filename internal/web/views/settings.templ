package views

type SettingsData struct {
	TenantName     string
	UserName       string
	Nav            []NavLink
	CSRFToken      string
	CompanyName    string
	Address        string
	Phone          string
	Email          string
	VATNumber      string
	DiscountLimit  string
	VarianceAlert  string
	BackdateDays   string
	AlertEmail     string
	AlertTelegram  string
	CanWrite       bool
	Error          string
}

templ Settings(d SettingsData) {
	@Layout("Settings", d.TenantName, d.UserName, d.Nav, settingsBody(d))
}

templ settingsBody(d SettingsData) {
	<article class="narrow">
		<header>
			<h1>Settings</h1>
			<p class="muted">Own dealership details and the rules that control discounts, backdates and alerts.</p>
		</header>

		if d.Error != "" {
			<p role="alert">{ d.Error }</p>
		}

		if d.CanWrite {
			<form method="post" action="/settings" class="narrow">
				<input type="hidden" name="csrf_token" value={ d.CSRFToken }/>

				<label>
					Company name
					<input type="text" name="company_name" value={ d.CompanyName } maxlength="120"/>
				</label>

				<label>
					Address
					<input type="text" name="address" value={ d.Address } maxlength="500"/>
				</label>

				<label>
					Phone
					<input type="text" name="phone" value={ d.Phone } maxlength="60"/>
				</label>

				<label>
					Email
					<input type="email" name="email" value={ d.Email } maxlength="200"/>
				</label>

				<label>
					VAT number
					<input type="text" name="vat_number" value={ d.VATNumber } maxlength="40"/>
				</label>

				<fieldset>
					<legend>Approval rules</legend>

					<label>
						Discount must be approved above % of the listed price
						<input type="number" name="discount_limit_percent" value={ d.DiscountLimit } min="0" max="100"/>
					</label>

					<label>
						Day-end variance alert (Rs)
						<input type="number" name="variance_alert_cents" value={ d.VarianceAlert } min="0"/>
					</label>

					<label>
						Document backdate limit (days)
						<input type="number" name="backdate_days" value={ d.BackdateDays } min="0" max="90"/>
					</label>
				</fieldset>

				<fieldset>
					<legend>Alerts</legend>

					<label>
						Alert email
						<input type="email" name="alert_email" value={ d.AlertEmail } maxlength="500"/>
					</label>

					<label>
						Telegram chat id
						<input type="text" name="alert_telegram_chat" value={ d.AlertTelegram } maxlength="100"/>
					</label>
				</fieldset>

				<div class="actions">
					<button type="submit">Save</button>
				</div>
			</form>
		} else {
			<p role="status">Only the owner can change settings.</p>
		}
	</article>
}
