package views

import "strings"

// NavLink is one top level destination. Here marks the section the request is
// in so the header can show it.
type NavLink struct {
	Href  string
	Label string
	Here  bool
}

// Layout is the frame every page shares: whose dealership this is, where else
// the person can go, who they are signed in as, and the way out.
templ Layout(title string, tenantName string, userName string, csrf string, nav []NavLink, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/pico.min.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			<header class="container site-header">
				<a class="brand" href="/">{ tenantName }</a>
				if len(nav) > 0 {
					<nav class="site-nav">
						for _, link := range nav {
							<a href={ link.Href } class={ navClass(link) }>{ link.Label }</a>
						}
					</nav>
				}
				if userName != "" {
					<div class="account">
						<span class="who">{ userName }</span>
						<form method="post" action="/logout">
							<input type="hidden" name="csrf_token" value={ csrf }/>
							<button type="submit">Sign out</button>
						</form>
					</div>
				}
			</header>
			<main class="container">
				@body
			</main>
		</body>
	</html>
}

func navClass(link NavLink) string {
	if link.Here {
		return "here"
	}
	return ""
}

// plural words a count the way a person says it: 1 invoice, 2 invoices.
func plural(n int, one, many string) string {
	if n == 1 {
		return one
	}
	return many
}

func orDash(s string) string {
	if strings.TrimSpace(s) == "" {
		return "—"
	}
	return s
}
