package views

import "time"

// ImportProblem is one row the file could not be taken in because of: the line
// it sits on, zero when the problem is about the file itself, and a sentence
// somebody can act on.
type ImportProblem struct {
	Line   int
	Detail string
}

// ImportFields is what the person typed, kept so a refusal does not make them
// type it again.
type ImportFields struct {
	DefaultMake string
	StockDate   string
}

// ImportRunView is one recorded run: which file, by whom, and the totals that
// file and this book agreed on. The two sides are always equal, because the
// database refuses to record a run where they differ, so the page shows one set
// of numbers rather than arguing with itself.
type ImportRunView struct {
	Kind      string
	KindLabel string
	Filename  string
	SHA       string
	Who       string
	At        time.Time
	Imported  int
	Skipped   int
	Head      []string
	Row       []string
}

// ImportRunRow is one line of the history.
type ImportRunRow struct {
	ID        string
	KindLabel string
	Filename  string
	SHA       string
	Imported  int
	Skipped   int
	Who       string
	At        time.Time
}

type ImportData struct {
	TenantName string
	UserName   string
	Nav        []NavLink
	CSRFToken  string
	Fields     ImportFields
	Problems   []ImportProblem
	Run        *ImportRunView
	Runs       []ImportRunRow
}

templ Import(d ImportData) {
	@Layout("Import", d.TenantName, d.UserName, d.CSRFToken, d.Nav, importBody(d))
}

templ importBody(d ImportData) {
	<article class="wide">
		<h1>Import</h1>

		if len(d.Problems) > 0 {
			<section role="alert">
				<h2>Not imported</h2>
				<ul>
					for _, p := range d.Problems {
						<li>
							if p.Line > 0 {
								<strong>Line { p.Line }:</strong>
							}
							{ p.Detail }
						</li>
					}
				</ul>
			</section>
		}

		if d.Run != nil {
			<section aria-live="polite">
				<h2>Run</h2>
				<dl class="facts">
					<dt>File</dt>
					<dd>
						{ d.Run.KindLabel }, { d.Run.Filename } <small class="muted">{ d.Run.SHA }</small>
					</dd>
					<dt>By</dt>
					<dd>{ d.Run.Who }, { d.Run.At.UTC().Format("2006-01-02 15:04") } UTC</dd>
					<dt>Written</dt>
					<dd>{ d.Run.Imported }</dd>
					<dt>Already there</dt>
					<dd>{ d.Run.Skipped }</dd>
				</dl>
				<div class="table-scroll">
					<table>
						<thead>
							<tr>
								for _, h := range d.Run.Head {
									<th scope="col">{ h }</th>
								}
							</tr>
						</thead>
						<tbody>
							<tr>
								for _, cell := range d.Run.Row {
									<td>{ cell }</td>
								}
							</tr>
						</tbody>
					</table>
				</div>
			</section>
		}

		<div class="split">
			<form method="post" action="/import/invoices" enctype="multipart/form-data">
				<h2>Invoices</h2>
				<input type="hidden" name="csrf_token" value={ d.CSRFToken }/>

				<label>
					File
					<input type="file" name="file" accept=".csv,text/csv" required/>
				</label>

				<label>
					Make
					<input type="text" name="default_make" value={ d.Fields.DefaultMake } maxlength="80" required/>
				</label>

				<button type="submit">Import invoices</button>
			</form>

			<form method="post" action="/import/stock" enctype="multipart/form-data">
				<h2>Yard sheet</h2>
				<input type="hidden" name="csrf_token" value={ d.CSRFToken }/>

				<label>
					File
					<input type="file" name="file" accept=".csv,text/csv" required/>
				</label>

				<label>
					Make
					<input type="text" name="default_make" value={ d.Fields.DefaultMake } maxlength="80"/>
				</label>

				<label>
					Received on
					<input type="date" name="received_on" value={ d.Fields.StockDate }/>
				</label>

				<button type="submit">Import yard sheet</button>

				<p><a href="/import/template">Template</a></p>
			</form>
		</div>

		<h2>Runs</h2>
		if len(d.Runs) == 0 {
			<p class="muted">No file has been imported yet.</p>
		} else {
			<div class="table-scroll">
				<table>
					<thead>
						<tr>
							<th scope="col">When (UTC)</th>
							<th scope="col">Kind</th>
							<th scope="col">File</th>
							<th scope="col">Written</th>
							<th scope="col">Already there</th>
							<th scope="col">By</th>
						</tr>
					</thead>
					<tbody>
						for _, run := range d.Runs {
							<tr>
								<td>{ run.At.UTC().Format("2006-01-02 15:04") }</td>
								<td>{ run.KindLabel }</td>
								<td>
									{ run.Filename } <small class="muted">{ run.SHA }</small>
								</td>
								<td>{ run.Imported }</td>
								<td>{ run.Skipped }</td>
								<td>{ run.Who }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</article>
}
