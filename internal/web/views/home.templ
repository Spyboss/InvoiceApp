package views

import "time"

type HomeData struct {
	TenantName  string
	UserName    string
	Nav         []NavLink
	Email       string
	Role        string
	Permissions []string
	CSRFToken   string
	CanSeeAudit bool
	SessionEnds time.Time
}

templ Home(d HomeData) {
	@Layout("Home", d.TenantName, d.UserName, d.Nav, homeBody(d))
}

templ homeBody(d HomeData) {
	<article>
		<header>
			<h1>{ d.UserName }</h1>
			<p>{ d.Email }</p>
		</header>
		<dl class="facts">
			<dt>Dealership</dt>
			<dd>{ d.TenantName }</dd>
			<dt>Role</dt>
			<dd>{ d.Role }</dd>
			<dt>Session ends</dt>
			<dd>{ d.SessionEnds.UTC().Format("2 Jan 2006 15:04") } UTC</dd>
		</dl>

		<h2>Permissions</h2>
		if len(d.Permissions) == 0 {
			<p class="muted">No extra permissions. Ask the owner if you need access.</p>
		} else {
			<ul class="permissions">
				for _, p := range d.Permissions {
					<li><code>{ p }</code></li>
				}
			</ul>
		}

		<footer>
			if d.CanSeeAudit {
				<p><a href="/audit">Audit log</a></p>
			}
			<form method="post" action="/logout">
				<input type="hidden" name="csrf_token" value={ d.CSRFToken }/>
				<button type="submit" class="secondary">Sign out</button>
			</form>
		</footer>
	</article>
}
