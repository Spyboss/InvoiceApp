package views

import "time"

type HomeData struct {
	TenantName  string
	UserName    string
	Nav         []NavLink
	CSRFToken   string
	Email       string
	Role        string
	Permissions []string
	SessionEnds time.Time
}

templ Home(d HomeData) {
	@Layout("Home", d.TenantName, d.UserName, d.CSRFToken, d.Nav, homeBody(d))
}

templ homeBody(d HomeData) {
	<article>
		<h1>{ d.UserName }</h1>

		<dl class="facts">
			<dt>Email</dt>
			<dd>{ d.Email }</dd>
			<dt>Dealership</dt>
			<dd>{ d.TenantName }</dd>
			<dt>Role</dt>
			<dd>{ d.Role }</dd>
			<dt>Signed in until</dt>
			<dd>{ d.SessionEnds.UTC().Format("2 Jan 2006 15:04") } UTC</dd>
		</dl>

		<h2>Permissions</h2>
		if len(d.Permissions) == 0 {
			<p class="muted">No extra permissions.</p>
		} else {
			<ul class="permissions">
				for _, p := range d.Permissions {
					<li><code>{ p }</code></li>
				}
			</ul>
		}
	</article>
}
