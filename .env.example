# Copy to .env and fill in. .env is gitignored and must never be committed.

# dev | staging | production
APP_ENV=dev

# Railway injects PORT. Locally the server defaults to :8080.
# PORT=8080

# postgres 18, local install, database created for this app
DATABASE_URL=postgres://invoice_app:CHANGE_ME@127.0.0.1:5432/invoiceapp_dev?sslmode=disable

# debug | info | warn | error
LOG_LEVEL=info

# Optional. On localhost, resolve to this tenant slug so no hosts file entry is
# needed. Must be empty when APP_ENV=production.
# TENANT_DEV=tangalle-motors

# Print documents. Gotenberg runs headless Chromium; on Railway it is a
# separate service reached over the private network. Leave empty to run without
# printing (the PDF button hides itself).
GOTENBERG_URL=http://127.0.0.1:3000
# Set both when the Gotenberg service has basic auth enabled.
# GOTENBERG_USERNAME=
# GOTENBERG_PASSWORD=

# Alert delivery. Both channels are optional and switch themselves off when
# empty; alerts still queue and still show at /alerts either way. Each
# dealership then chooses its own destination (alert email, telegram chat) on
# the settings screen, and a blank there keeps that channel off for them.
# ALERT_SMTP_HOST=smtp.example.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USERNAME=
# ALERT_SMTP_PASSWORD=
# The address mail is sent as. The relay usually insists it is one of its own.
# ALERT_SMTP_FROM=alerts@example.com
# Bot token from @BotFather. The chat id comes from the tenant's settings.
# ALERT_TELEGRAM_TOKEN=
