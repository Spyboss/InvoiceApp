# Copy to .env and fill in. .env is gitignored and must never be committed.

# dev | staging | production
APP_ENV=dev

# Railway injects PORT. Locally the server defaults to :8080.
# PORT=8080

# postgres 18, local install, database created for this app
DATABASE_URL=postgres://invoice_app:CHANGE_ME@127.0.0.1:5432/invoiceapp_dev?sslmode=disable

# debug | info | warn | error
LOG_LEVEL=info

# Optional. On localhost, resolve to this tenant slug so no hosts file entry is
# needed. Must be empty when APP_ENV=production.
# TENANT_DEV=tangalle-motors

# Print documents. Gotenberg runs headless Chromium; on Railway it is a
# separate service reached over the private network. Leave empty to run without
# printing (the PDF button hides itself).
GOTENBERG_URL=http://127.0.0.1:3000
# Set both when the Gotenberg service has basic auth enabled.
# GOTENBERG_USERNAME=
# GOTENBERG_PASSWORD=
